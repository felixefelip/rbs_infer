#!/usr/bin/env ruby
# frozen_string_literal: true

require "rbs_infer"
require "fileutils"
require "yaml"
require "optparse"

output = false
output_dir = "sig/generated"
max_passes = 10
files = []

# When set, the stabilization loop prints a line-level diff every time a
# file's regenerated RBS differs from the previous pass. This surfaces the
# member/type that oscillates when a file never converges (the warning at
# the end only reports the COUNT of still-changing files, not *what* keeps
# changing). See felixefelip/rbs_infer#9 (Array[Array[...]] nesting growth).
debug_convergence = ENV.key?("RBS_INFER_DEBUG_CONVERGENCE")

parser = OptionParser.new do |opts|
  opts.banner = "Usage: rbs_infer [options] FILE_OR_DIR [...]"

  opts.on("--output", "Write RBS to sig/generated/ (based on source file path)") do
    output = true
  end

  opts.on("--output-dir DIR", "Output directory (default: sig/generated)") do |dir|
    output = true
    output_dir = dir
  end

  opts.on("--max-passes N", Integer, "Max iterative passes for type convergence (default: 10)") do |n|
    max_passes = n
  end

  opts.on("-v", "--version", "Show version") do
    puts "rbs_infer #{RbsInfer::VERSION}"
    exit
  end

  opts.on("-h", "--help", "Show this help") do
    puts opts
    exit
  end
end

parser.parse!
inputs = ARGV

if inputs.empty?
  puts parser
  exit 1
end

# Expandir diretórios para todos os .rb contidos neles (recursivamente)
files = inputs.flat_map do |input|
  if File.directory?(input)
    Dir[File.join(input, "**/*.rb")]
  else
    [input]
  end
end

if files.empty?
  warn "No .rb files found in: #{inputs.join(', ')}"
  exit 1
end

# `source_files` is the corpus a run RESOLVES against: call sites (`.new`,
# external setters, forwarding wrappers) and the declarations the expansion
# passes read (`ActiveSupport::Concern`, transcribed under
# `sig/generated/steep_ar_runtime/`, is what says a `class_methods do` block is
# later `module_eval`ed into a `ClassMethods` constant).
#
# It is the project's Steepfile, and nothing else. `check` is where the project
# itself says its Ruby lives — the same list `steep check` reads, so the corpus
# cannot drift from what the checker sees. Guessing a Rails layout
# (`app/`/`engines/`/`lib/`) was wrong in both directions: it missed a project
# that keeps code elsewhere, and it missed the pseudo-code sidecars under
# `sig/`, which erased a concern's whole `ClassMethods` block from a one-file
# run (felixefelip/rbs_infer#291) — a Steepfile that already said
# `check 'sig/**/*.rb'` had been saying so all along.
#
# `ignores: false`, because the corpus is not the check list. A Steepfile
# `ignore` says "report no diagnostics here", not "this file is not part of the
# program", and a framework-patching file is exactly the shape that gets
# ignored while still declaring the DSL a checked file calls. This is the same
# distinction `ModuleSelfTypeGenerator#declared_files` draws
# (felixefelip/rbs_infer#222), and the two now read one list.
#
# The INPUT paths stay unioned in: `source_files` must include what this run
# was asked to analyze even when the Steepfile does not check it (a caller
# living outside the checked tree is otherwise invisible and the param it
# types degrades to `untyped` — felixefelip/rbs_infer#76). With no Steepfile
# they are the whole corpus — a run resolves against what it was pointed at
# and says so, rather than against a layout nobody declared. There is no
# second, quieter answer to fall back to: what this RBS is FOR is
# `steep check`, and a project not running it has no Steepfile to read.
steepfile_sources = RbsInfer::Project::SteepfileSources.call(ignores: false)
if steepfile_sources.nil?
  warn "rbs_infer: no usable Steepfile; resolving call sites only against " \
       "the paths given (#{inputs.join(', ')}). Types that depend on a call " \
       "site elsewhere will be `untyped`."
end

source_files = (files + steepfile_sources.to_a).uniq

rails_project = Gem::Specification.find_by_name("rails") rescue nil

if rails_project
  # Registers the ERB path -> class convention, so a template is selected as a caller of
  # the class it is the body of (the core reads it as Ruby either way).
  require "rbs_infer/extensions/rails/views/erb_source_owner"

  # Emit the module/concern self-type sidecar up front so that every Steep
  # type-check during this run (target *and* caller files) sees the
  # `@type self:`/`@type instance:` annotations (felixefelip/rbs_infer#52).
  require "rbs_infer/extensions/rails/module_self_type_generator"
  RbsInfer::Extensions::Rails::ModuleSelfTypeGenerator.new(app_dir: Dir.pwd).generate
  Steep::Source::ModuleSelfTypes.reset!
end

generate = lambda do |inputs_to_process, silent: false|
  changed_files = []

  inputs_to_process.each do |input|
    is_path = input.include?("/") || input.end_with?(".rb")
    args = if is_path
             { target_file: input, source_files: source_files }
           else
             { target_class: input, source_files: source_files }
           end


    analyzer = RbsInfer::Analyzer.new(**args)
    rbs = analyzer.generate_rbs

    unless rbs
      warn "#{input}: class not found or no members detected."
      next
    end

    if output
      source_path = analyzer.target_file || input
      output_path = File.join(output_dir, source_path.sub(/\.rb$/, ".rbs"))

      FileUtils.mkdir_p(File.dirname(output_path))

      # Debug sidecar: the expanded view (pseudo-code) that fed the
      # inference, following the `.steep_contracts.yml` precedent — lives
      # under `sig/` but is inert to RBS/Steep (the glob only loads
      # `*.rbs`). See felixefelip/rbs_infer#19.
      if analyzer.expanded_source
        expanded_path = File.join(output_dir, ".expanded", source_path)
        FileUtils.mkdir_p(File.dirname(expanded_path))
        header = <<~HEADER
          # ⚠️  Generated by rbs_infer for debugging — NEVER loaded at runtime.
          #     Expanded view of #{source_path} (macros desugared into pseudo-code).
          #     Regenerated on every run; do not edit.
        HEADER
        File.write(expanded_path, header + analyzer.expanded_source)
      end

      # `RbsBuilder#build` already terminates with a single `\n`, so
      # `rbs` ends in a newline. Don't double it up.
      new_content = rbs.end_with?("\n") ? rbs : "#{rbs}\n"
      old_content = File.exist?(output_path) ? File.read(output_path) : nil

      File.write(output_path, new_content)
      puts output_path unless silent

      if new_content != old_content
        changed_files << input
        if debug_convergence && old_content
          old_lines = old_content.lines
          new_lines = new_content.lines
          removed = old_lines - new_lines
          added   = new_lines - old_lines
          warn "── #{output_path} changed ──"
          removed.each { |l| warn "  - #{l.chomp}" }
          added.each   { |l| warn "  + #{l.chomp}" }
        end
      end
    else
      puts rbs
    end
  end

  changed_files
end

if output
  sorter = RbsInfer::Project::DependencySorter.new(files)
  levels = sorter.sorted_levels
  neighbors = sorter.neighbors

  # A file whose RBS changed can move the RBS of every file it shares a dependency
  # edge with, in either direction — see `DependencySorter#neighbors`. Requeueing
  # only the files whose own RBS changed left a type one whole CLI invocation
  # behind whenever the file that had to read it sat in an earlier level and did
  # not change in the pass.
  with_neighbors = lambda do |changed|
    changed.flat_map { |file| [file, *neighbors[file]] }.uniq
  end

  reset_caches = lambda do
    RbsInfer::Signatures::SteepEnvironment.reset!
    # Run-wide RBS file/glob caches: clear so a freshly-written sig file (new
    # path or changed content) is re-globbed/re-parsed on the next level/pass
    # (felixefelip/rbs_infer#47).
    RbsInfer::Signatures::RbsTypeLookup.reset!
  end

  all_changed = []
  levels.each_with_index do |level_files, idx|
    # Reset Steep cache between levels so it picks up RBS from prior levels
    reset_caches.call if idx > 0
    changed = generate.call(level_files)
    all_changed.concat(changed)
  end

  # Stabilization: re-run the changed files and their graph neighbours (handles
  # cycles, indirect deps, and the caller/callee split described above).
  # `changed` still means "files whose RBS changed in the last pass", so what
  # ends the loop is unchanged — only the set re-analyzed each pass widens.
  pass = 1
  changed = all_changed.uniq
  while changed.any? && pass < max_passes
    pass += 1
    reset_caches.call
    changed = generate.call(with_neighbors.call(changed), silent: true)
  end

  if changed.any?
    warn "Warning: types did not converge after #{max_passes} stabilization passes " \
         "(#{changed.size} files still changing). Try increasing --max-passes."
  end
else
  generate.call(files)
end

# The `.steep_postconditions.yml` half of the marker: WHERE the relocated
# methods are declared is the RBS above, WHEN they exist is this
# (felixefelip/rbs_infer#245). Steep globs `sig/**/.steep_postconditions.yml`
# and merges, so this sits BESIDE the one Steep writes itself — in a directory
# of its own, never on top of it.
#
# The directory is the whole point. Steep writes its own inferred
# postconditions to `sig/generated/.steep_postconditions.yml`
# (`Steep::Postconditions::Runner::DEFAULT_OUTPUT_PATH`), which is exactly
# `File.join(output_dir, ".steep_postconditions.yml")` under the default
# `--output-dir`. Sharing that path means whoever runs last wins: a project
# with no `self.class.class_eval` swept the file away on every run (the
# `rm_f` below), so `make steep && make rbs_infer_all` deleted the facts
# `make steep` had just inferred, and the next run lost every type that
# depended on them — a controller's `@x = current_user.things` fell back to
# `nil` and stopped being declared at all. A project that HAS one clobbered
# Steep's entries with its own instead. Both directions are the same bug.
#
# Not a dot-directory: Steep's glob is a plain `Dir.glob`, whose `**` does not
# descend into hidden directories, so a `.rbs_infer_postconditions/` here would
# be written and never read.
#
# Swept once over the inputs at the end, not accumulated during generation:
# `generate` runs once per dependency level and again per stabilization pass,
# and the entries would be written as many times over.
if output
  postconditions = files.sort.flat_map do |file|
    RbsInfer::Project::SelfClassEvalMarker.postconditions_for(File.read(file))
  rescue StandardError
    []
  end

  sidecar = File.join(output_dir, "rbs_infer_postconditions", ".steep_postconditions.yml")
  if postconditions.empty?
    # Removed rather than left behind: a stale entry names a marker the RBS no
    # longer declares, and the narrowing then silently stops applying. Safe to
    # remove now that the path is ours alone.
    FileUtils.rm_f(sidecar)
  else
    FileUtils.mkdir_p(File.dirname(sidecar))
    File.write(sidecar, YAML.dump("version" => 1, "postconditions" => postconditions))
    puts sidecar
  end
end
