class Example84
  module Writer
    def self.define_stored: (singleton(Example84) model, (Example84::Reflection & Example84::Reflection::AfterRename) reflection) -> untyped
  end

  def self.has_renamed: ((:posts | :comments) name, (:articles | :replies) as) -> untyped
  def self.summary: () -> [ :renamed, :renamed ]
end

class Example84
  class Reflection
    attr_reader name: :posts | :comments | :articles | :replies

    def initialize: ((:posts | :comments) name) -> void
    def rename: ((:articles | :replies) to) -> (:articles | :replies)

    class AfterInitialize
      attr_reader name: :posts | :comments
    end

    class AfterRename
      attr_reader name: :articles | :replies
    end
  end
end
