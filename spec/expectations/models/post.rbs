class Post < ApplicationRecord
  extend Enumerize
  extend ::Post::Taggable::ClassMethods
  include ::Post::Taggable
  include ::Post::Commentable
  include ::Post::Notifiable
  include ::Post::Exportable
  include Test::Filtrable

  def summary: (?Integer length) -> String
  def test_status: () -> Post::EnumerizeStatusValue
  def was_archived?: () -> bool
  def creator: () -> ::User?
  def author_name: () -> String
  def display_author: () -> String
  def publish!: () -> self
  def comments_count: () -> Integer
  def add_comment: (author: untyped, body: untyped) -> Comment
  def was_priority_high: () -> bool?
  def publish_in_transaction: () -> self
  def popular_tags: (?Integer limit) -> untyped
  def tag_limit: () -> Integer
  def tag_named: () -> (Tag & Tag::Validated)?
  def sibling_tag_names: () -> Array[String]
  def iterate_tags: () -> Post_Tag::ActiveRecord_Associations_CollectionProxy
  def archive: () -> Post_Comment::ActiveRecord_Associations_CollectionProxy
  def archive_via_singleton: () -> Post_Comment::ActiveRecord_Associations_CollectionProxy
  def test_enumerize_status: () -> Post::EnumerizeStatusAttribute
  def test_enumerize_status_options: () -> Array[Array[untyped]]
  def user_email: () -> String?
  def full_name: () -> String
  def user_created_at: () -> ActiveSupport::TimeWithZone?
  def name: () -> String?
  def user_updated_at: () -> ActiveSupport::TimeWithZone?
end
