class Example2
  def self.run: () -> String
end

class Example2
  class User
    attr_reader name: "John Doe"

    def initialize: (name: "John Doe") -> void
  end
end

class Example2
  class Foo
    attr_reader user: untyped
    attr_reader name: "John Doe"?
    attr_writer name: "John Doe"?

    def user=: (Example2::User value) -> "John Doe"

    class AfterUser
