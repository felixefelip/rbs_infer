class Example83
  module Writer
    def self.define_direct: (singleton(Example83) model, (:tags | :labels) name) -> (:tags | :labels)
    def self.define_stored: (singleton(Example83) model, Example83::Reflection reflection) -> (:posts | :comments)
  end

  def self.has_direct: ((:tags | :labels) name) -> (:tags | :labels)
  def self.has_stored: ((:posts | :comments) name) -> (:posts | :comments)
  def self.summary: () -> [ :direct, :direct, :stored, :stored ]
end

class Example83
  class Reflection
    attr_reader name: (:posts | :comments)

    def initialize: ((:posts | :comments) name) -> void
  end
end
