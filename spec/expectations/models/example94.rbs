module Example94
  class Wheel
    def label: () -> :spoked
  end
end

module Example94
  class Seat
    def label: () -> :cushioned
  end
end

module Example94
  class Bench
    def label: () -> :bench
  end
end

module Example94
  class Door
    def label: () -> :sliding
  end
end

module Example94
  class Base
    self.@registry: Hash[:wheel | :seat | :door, Example94::Wheel | Example94::Seat | Example94::Bench | Example94::Door]?

    def self.registry: () -> Hash[:wheel | :seat | :door, Example94::Wheel | Example94::Seat | Example94::Bench | Example94::Door]
    def self.register: ((:wheel | :seat | :door) name, (Wheel | Seat | Bench | Door) value) -> (Wheel | Seat | Bench | Door)
    def self.lookup: ((:wheel | :seat | :door) name) -> (Example94::Wheel | Example94::Seat | Example94::Bench | Example94::Door)
    def self.describe: ((:wheel | :seat) name) -> (:wheel_label | :seat_label)
  end
end

module Example94
  class Car < Base
    def wheel: () -> Example94::Wheel
    def seat: () -> Example94::Seat
  end
end

module Example94
  class Truck < Base
    def seat: () -> Example94::Bench
    def door: () -> Example94::Door
  end
end
