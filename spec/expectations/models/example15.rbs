class Example15
  @halted: true?

  def run: () -> String?

  private

  def halt: () -> true
  def verify: () -> Example15::User
  def set_user: () -> Example15::User
end

class Example15
  class User
    attr_reader name: "Joe"

    def initialize: (name: "Joe") -> void
  end
end

class Example15
  class Registry
    self.@user: Example15::User?

    def self.user: () -> Example15::User?
    def self.user=: (User value) -> Example15::User
  end
end
