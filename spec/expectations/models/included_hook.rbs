class IncludedHook
  module Hookable
    def self.included: (Module base) -> Symbol
  end

  module Sugared
    extend ActiveSupport::Concern
  end

  module Homespun
    extend ::IncludedHook::HomeMade
  end

  module Arbitrary
    def self.foo_included: (untyped base) -> untyped
  end

  include Slots
  include Hookable
  include Sugared
  include Homespun
end
