module Example96
  class Plain
  end
end

module Example96
  class Through
  end
end

module Example96
  class Reflection
    attr_reader name: (:posts | :taggings)
    attr_reader reflection_options: ({ through: :taggings } | Hash[untyped, untyped] | Hash[Symbol, untyped])

    def initialize: ((:posts | :taggings) name, ({ through: :taggings } | Hash[untyped, untyped] | Hash[Symbol, untyped]) options) -> void
    def association_kind: () -> (singleton(Example96::Through) | singleton(Example96::Plain))
  end
end

module Example96
  class NormalizedReflection
    attr_reader name: (:posts | :taggings)
    attr_reader reflection_options: Hash[Symbol, untyped]

    def initialize: ((:posts | :taggings) name, Hash[Symbol, untyped] options) -> void
    def association_kind: () -> (singleton(Example96::Through) | singleton(Example96::Plain))

    private

    def without_counter_cache: (Hash[Symbol, untyped] options) -> Hash[Symbol, untyped]
  end
end

module Example96
  class Builder
    def self.stored: ((:posts | :taggings) name, ({ through: :taggings } | Hash[untyped, untyped]) options) -> Reflection
    def self.with_keywords: ((:posts | :taggings) name, **untyped) -> Reflection
    def self.normalized: ((:posts | :taggings) name, **untyped) -> NormalizedReflection
  end
end

module Example96
  class Tags
    def self.stored_through: () -> singleton(Example96::Through)
    def self.stored_plain: () -> singleton(Example96::Plain)
    def self.keywords_through: () -> singleton(Example96::Through)
    def self.keywords_plain: () -> singleton(Example96::Plain)
    def self.normalized_through: () -> singleton(Example96::Through)
    def self.normalized_plain: () -> singleton(Example96::Plain)
  end
end
