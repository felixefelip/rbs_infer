module Example96
  class Plain
  end
end

module Example96
  class Through
  end
end

module Example96
  class Reflection
    attr_reader name: (:posts | :taggings)
    attr_reader options: ({ through: :taggings } | Hash[untyped, untyped] | { ?through: :taggings })

    def initialize: ((:posts | :taggings) name, ({ through: :taggings } | Hash[untyped, untyped] | { ?through: :taggings }) options) -> void
    def association_kind: () -> (singleton(Example96::Through) | singleton(Example96::Plain))
  end
end

module Example96
  class NormalizedReflection
    attr_reader name: (:posts | :taggings)
    attr_reader options: { ?counter_cache: true, ?through: :taggings, ?autosave: true }

    def initialize: ((:posts | :taggings) name, { ?counter_cache: true, ?through: :taggings } options) -> void
    def association_kind: () -> (singleton(Example96::Through) | singleton(Example96::Plain))

    private

    def without_counter_cache: ({ ?counter_cache: true, ?through: :taggings } options) -> Hash[Symbol, untyped]

    class AfterInitialize
      attr_reader options: Hash[Symbol, untyped]
    end
  end
end

module Example96
  class AutosavedReflection < NormalizedReflection
    def autosave=: (true autosave) -> true
  end
end

module Example96
  class Builder
    def self.stored: ((:posts | :taggings) name, ({ through: :taggings } | Hash[untyped, untyped]) options) -> Reflection
    def self.with_keywords: ((:posts | :taggings) name, ?through: :taggings) -> Reflection
    def self.normalized: ((:posts | :taggings) name, ?through: :taggings, ?counter_cache: true) -> NormalizedReflection
    def self.autosaved_kind: ((:posts | :taggings) name, ?through: :taggings, ?counter_cache: true) -> (singleton(Example96::Through) | singleton(Example96::Plain))
  end
end

module Example96
  class Statuses
    def self.listed: () -> nil
  end
end

module Example96
  class Tags
    def self.stored_through: () -> singleton(Example96::Through)
    def self.stored_plain: () -> singleton(Example96::Plain)
    def self.keywords_through: () -> singleton(Example96::Through)
    def self.keywords_plain: () -> singleton(Example96::Plain)
    def self.normalized_through: () -> singleton(Example96::Through)
    def self.normalized_plain: () -> singleton(Example96::Plain)
    def self.autosaved_through: () -> singleton(Example96::Through)
    def self.autosaved_plain: () -> singleton(Example96::Plain)
  end
end
