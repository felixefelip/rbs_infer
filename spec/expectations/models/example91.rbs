module Example91
  module Core
  end

  module Core::ClassMethods
    @generated_association_methods: Module?

    def generated_association_methods: () -> singleton(Example91::Post::GeneratedAssociationMethods)
  end

  module Builder
  end
end

module Example91
  module Builder
    class HasReader
      def self.build: (singleton(Example91::Base) model, (:comments | :tags) name) -> (:comments | :tags)
      def self.define_accessors: (singleton(Example91::Base) model, (:comments | :tags) name) -> (:comments | :tags)
      def self.define_readers: (singleton(Example91::Post::GeneratedAssociationMethods) mixin, (:comments | :tags) name) -> (:comments | :tags)
    end
  end
end

module Example91
  class Base
    extend Core::ClassMethods

    def self.has_reader: ((:comments | :tags) name) -> (:comments | :tags)
  end
end

module Example91
  class Post < Base
  end
end

module Example91
  class Use
    def self.comments: () -> 1
    def self.tags: () -> 1
  end
end
