class Example28
  module Foo
    attr_reader bazingado_block: untyped

    def bazinga: (singleton(::Example28::Baz) module_included) -> untyped
    def bazingado: () ?{ (*untyped) -> :age_after_a_decade } -> (^(*untyped) -> :age_after_a_decade)?
  end

  module Baz
    extend ::Example28::Foo
  end

  class AfterBazingado
    attr_reader bazingado_block: (^(*untyped) -> :age_after_a_decade)?
  end
end

class Example28
  class Bar
    extend ::Example28::Foo

    def self.validade_age: () -> "validating age"

    def age: () -> 42
    def call_test: () -> "Hello, world!"
    def greet: () -> "Hello, world!"
    def age_after_a_decade: () -> Integer
  end
end
