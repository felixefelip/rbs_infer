class Example16
  @halted: true?

  def show: () -> ("Hi, COOKIE!" | "Hi, TOKEN!")
  def call: () -> ("Hi, COOKIE!" | "Hi, TOKEN!")?

  private

  def authenticate: () -> (Example16::User | true)
  def resume: () -> Example16::User?
  def from_token: () -> (Example16::User | true)
  def deny: () -> true
  def halt: () -> true
  def cookie?: () -> bool
  def token?: () -> bool
end

class Example16
  class User
    attr_reader name: ("cookie" | "token")

    def initialize: (name: ("cookie" | "token")) -> void
  end
end

class Example16
  class Registry
    self.@user: Example16::User?

    def self.user: () -> Example16::User?
    def self.user=: (Example16::User value) -> Example16::User
  end
end
