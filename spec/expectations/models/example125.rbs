module Example125
  class Catalog
    @lookups: Hash[untyped, untyped]

    def initialize: () -> void
    def lookup: (untyped entry) -> (String | untyped)
    def reset: (untyped entry) -> :reset
  end
end

module Example125
  class Admin
    @catalog: Example125::Catalog

    def initialize: (Example125::Catalog catalog) -> void
    def clear: () -> :reset
  end
end

module Example125
  class Reader
    @catalog: Example125::Catalog

    def initialize: (Example125::Catalog catalog) -> void
    def label: () -> (String | untyped)
  end
end

module Example125
  class App
    def self.run: () -> (String | untyped)
  end
end
