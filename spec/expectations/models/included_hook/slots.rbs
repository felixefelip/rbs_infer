class IncludedHook
  module Slots
    @slot: String?
    @badge: String?
    @stamp: String?

    def slot: () -> String?
    def slot=: ("value" value) -> String?
    def badge: () -> String?
    def badge=: ("value" value) -> String?
    def stamp: () -> String?
    def stamp=: ("value" value) -> String?
  end
end
