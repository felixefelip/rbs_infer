class Example52
  module Foo
    def banana_class_method: () ?{ (*untyped) -> Symbol } -> untyped
    def included: (Module base) -> Module?
  end

  module Baz
    extend ::Example52::Foo
  end
end

class Example52
  class Bar
    extend ::Example52::Baz::BananaMethods
    include ::Example52::Baz

    def self.call_age: () -> Integer
  end
end

class Example52
  module Baz
    module BananaMethods
      def age: () -> Integer
    end
  end
end
