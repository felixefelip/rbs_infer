module ActiveSupport
  module Concern
    @_included_block: (^(*untyped) -> untyped)?

    def self.extended: (Object base) -> untyped | ...

    def append_features: (Module base) -> bool? | ...
    def class_methods: () { (Module) -> (:declare | :default_values | :human_name | :touch_recently_tagged | :vault_key | :has_rich_text) } -> untyped | ...
    def included: (?Module? base) ?{ (*untyped) -> (:creation_window | :window_days | :relevant? | :badge | :stamp) } -> (^(*untyped) -> untyped)? | ...
  end
end
