class Article
  def content: () -> ActionText::RichText
  def content?: () -> bool
  def content=: (untyped body) -> untyped
  def summary: () -> ActionText::RichText
  def summary?: () -> bool
  def summary=: (untyped body) -> untyped

  class AfterContent
    def rich_text_content: () -> ::ActionText::RichText
  end

  class AfterSummary
    def rich_text_summary: () -> ::ActionText::RichText
  end
end
