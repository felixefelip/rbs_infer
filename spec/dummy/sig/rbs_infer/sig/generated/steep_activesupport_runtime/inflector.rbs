module ActiveSupport
  module Inflector
    def inflections: (?Symbol locale) ?{ (untyped) -> untyped } -> untyped | ...
    def singularize: (String word, ?Symbol locale) -> String | ...
    def pluralize: (untyped word, ?Symbol locale) -> untyped | ...

    private

    def apply_inflections: (untyped word, untyped rules, ?Symbol locale) -> untyped | ...
  end
end

module ActiveSupport
  module Inflector
    class Inflections
      self.@__instance__: Concurrent::Map[untyped, untyped]

      @acronym_regex: Regexp

      def self.instance: (?Symbol locale) -> untyped | ...
      def self.instance_or_fallback: (Symbol locale) -> untyped

      @plurals: Array[untyped]
      @singulars: Array[untyped]
      @uncountables: Uncountables[untyped] | ActiveSupport::Inflector::Inflections::Uncountables[untyped]
      @humans: Array[untyped]
      @acronyms: Hash[untyped, untyped]
      @acronyms_camelize_regex: Regexp
      @acronyms_underscore_regex: Regexp
      def plurals: () -> Array[untyped] | ...
      def singulars: () -> Array[untyped] | ...
      def uncountables: () -> (Uncountables[untyped] | ActiveSupport::Inflector::Inflections::Uncountables[untyped]) | ...
      def humans: () -> Array[untyped] | ...
      def acronyms: () -> Hash[untyped, untyped] | ...
      def acronyms_camelize_regex: () -> Regexp | ...
      def acronyms_underscore_regex: () -> Regexp | ...

      def initialize: () -> void | ...
      def initialize_dup: (untyped orig) -> Regexp | ...
      def acronym: (untyped word) -> Regexp | ...
      def plural: (Regexp rule, untyped replacement) -> Array[untyped] | ...
      def singular: (Regexp rule, untyped replacement) -> Array[untyped] | ...
      def irregular: (untyped singular, untyped plural) -> Array[untyped] | ...
      def uncountable: (*untyped words) -> ActiveSupport::Inflector::Inflections::Uncountables[untyped] | ...
      def human: (untyped rule, untyped replacement) -> Array[untyped] | ...
      def clear: (?Symbol scope) -> (Array[untyped] | nil | Regexp) | ...

      private

      def define_acronym_regex_patterns: () -> Regexp | ...

      class AfterClear
        attr_reader uncountables: ActiveSupport::Inflector::Inflections::Uncountables[untyped]
      end

      class AfterInitialize
        attr_reader uncountables: ActiveSupport::Inflector::Inflections::Uncountables[untyped]
      end
    end
  end
end

module ActiveSupport
  module Inflector
    class Inflections
      class Uncountables[T] < ::Array[T]
        @regex_array: Array[untyped]

        def initialize: () -> void | ...
        def delete: (String entry) -> untyped | ...
        def <<: (*untyped word) -> self | ...
        def add: (Array[untyped] words) -> self | ...
        def uncountable?: (untyped str) -> bool | ...

        private

        def to_regex: (untyped string) -> Regexp | ...
      end
    end
  end
end

class String
  def singularize: (?Symbol locale) -> self | ...
end
