module ActiveSupport
  module Inflector
    def inflections: (?Symbol locale) ?{ (ActiveSupport::Inflector::Inflections) -> untyped } -> (ActiveSupport::Inflector::Inflections | ActiveSupport::Inflector::Inflections::Uncountables[untyped]) | ...
    def singularize: ("comments" word, ?Symbol locale) -> "comment" | ...
    def pluralize: (untyped word, ?Symbol locale) -> untyped | ...
    def camelize: (String term, ?bool uppercase_first_letter) -> (String | "Comments" | "Comment") | ...
    def demodulize: ("Example109::Post" path) -> "Post" | ...
    def constantize: (String camel_cased_word) -> untyped | ...
    def safe_constantize: (String camel_cased_word) -> untyped? | ...

    private

    def apply_inflections: (("comments" | untyped) word, untyped rules, ?Symbol locale) -> untyped | ...
    def const_regexp: ((String | untyped) camel_cased_word) -> (untyped | String) | ...
  end
end

module ActiveSupport
  module Inflector
    class Inflections
      self.@__instance__: Concurrent::Map[untyped, untyped]

      @acronym_regex: Regexp

      def self.instance: (?Symbol locale) -> ActiveSupport::Inflector::Inflections | ...
      def self.instance_or_fallback: (Symbol locale) -> ActiveSupport::Inflector::Inflections

      @plurals: Array[untyped]
      @singulars: Array[untyped]
      @uncountables: Uncountables[untyped] | ActiveSupport::Inflector::Inflections::Uncountables[untyped]
      @humans: Array[untyped]
      @acronyms: Hash[untyped, untyped]
      @acronyms_camelize_regex: Regexp
      @acronyms_underscore_regex: Regexp
      def plurals: () -> Array[untyped] | ...
      def singulars: () -> Array[untyped] | ...
      def uncountables: () -> (Uncountables[untyped] | ActiveSupport::Inflector::Inflections::Uncountables[untyped]) | ...
      def humans: () -> Array[untyped] | ...
      def acronyms: () -> Hash[untyped, untyped] | ...
      def acronyms_camelize_regex: () -> Regexp | ...
      def acronyms_underscore_regex: () -> Regexp | ...

      def initialize: () -> void | ...
      def initialize_dup: (untyped orig) -> Regexp | ...
      def acronym: (untyped word) -> Regexp | ...
      def plural: (Regexp rule, ("s" | "\1es" | "\1i" | "\1ses" | "\1oes" | "\1a" | "ses" | "\1\2ves" | "\1s" | "\1ies" | "\1ices" | "\1ice" | "\1en" | "\1" | "\1zes") replacement) -> Array[untyped] | ...
      def singular: (Regexp rule, ("" | "\1" | "\1ews" | "\1um" | "\1sis" | "\1fe" | "\1f" | "\1y" | "\1eries" | "\1ovie" | "\1ouse" | "\1is" | "\1xis" | "\1us" | "\1ex" | "\1ix") replacement) -> Array[untyped] | ...
      def irregular: (("person" | "man" | "child" | "sex" | "move" | "zombie") singular, ("people" | "men" | "children" | "sexes" | "moves" | "zombies") plural) -> Array[untyped] | ...
      def uncountable: (*Array[("equipment" | "information" | "rice" | "money" | "species" | "series" | "fish" | "sheep" | "jeans" | "police")] words) -> ActiveSupport::Inflector::Inflections::Uncountables[untyped] | ...
      def human: (untyped rule, untyped replacement) -> Array[untyped] | ...
      def clear: (?Symbol scope) -> (Array[untyped] | nil | Regexp) | ...

      private

      def define_acronym_regex_patterns: () -> Regexp | ...

      class AfterClear
        attr_reader uncountables: ActiveSupport::Inflector::Inflections::Uncountables[untyped]
      end

      class AfterInitialize
        attr_reader uncountables: ActiveSupport::Inflector::Inflections::Uncountables[untyped]
      end
    end
  end
end

module ActiveSupport
  module Inflector
    class Inflections
      class Uncountables[T] < ::Array[T]
        @regex_array: Array[untyped]

        def initialize: () -> void | ...
        def delete: ((String | untyped) entry) -> untyped? | ...
        def <<: (*untyped word) -> self | ...
        def add: ((Array[untyped] | Array[(Array[("equipment" | "information" | "rice" | "money" | "species" | "series" | "fish" | "sheep" | "jeans" | "police")] | untyped)]) words) -> self | ...
        def uncountable?: (untyped str) -> bool | ...

        private

        def to_regex: ((String | untyped) string) -> Regexp | ...
      end
    end
  end
end

class String
  def singularize: (?Symbol locale) -> "comment" | ...
  def camelize: (?Symbol first_letter) -> self | ...
  def demodulize: () -> "Post" | ...
  def constantize: () -> untyped | ...
  def safe_constantize: () -> untyped? | ...
end
