module Concurrent
  module Collection
    class MapImplementation = Concurrent::Collection::MriMapBackend
  end
end

module Concurrent
  class Map[unchecked out K, unchecked out V] < Collection::MapImplementation
    @default_proc: (^(?untyped, ?untyped, *untyped) -> untyped)?

    def initialize: (?untyped options) ?{ (*untyped) -> untyped } -> void | ...
    def []: (untyped key) -> untyped | ...
    def fetch: (untyped key, ?Object default_value) ?{ (untyped) -> untyped } -> untyped | ...
    def fetch_or_store: (untyped key, ?Object default_value) ?{ (untyped) -> untyped } -> untyped | ...
    def put_if_absent: (untyped key, untyped value) -> untyped | ...
    def value?: (untyped value) -> bool | ...
    def keys: () -> Array[untyped] | ...
    def values: () -> Array[untyped] | ...
    def each_key: () { (untyped) -> untyped } -> (self | Enumerator[untyped, untyped]) | ...
    def each_value: () { (untyped) -> nil } -> (self | Enumerator[untyped, untyped]) | ...
    def each_pair: () -> (self | Enumerator[untyped, untyped]) | ...
    def key: (untyped value) -> nil | ...
    def empty?: () -> bool | ...
    def size: () -> Integer | ...
    def marshal_dump: () -> Hash[untyped, untyped] | ...
    def marshal_load: (untyped hash) -> self | ...
    def inspect: () -> String | ...

    private

    def raise_fetch_no_key: () -> bot | ...
    def initialize_copy: (untyped other) -> self | ...
    def populate_from: (untyped hash) -> self | ...
    def validate_options_hash!: (Hash[untyped, untyped] options) -> untyped | ...
  end
end
