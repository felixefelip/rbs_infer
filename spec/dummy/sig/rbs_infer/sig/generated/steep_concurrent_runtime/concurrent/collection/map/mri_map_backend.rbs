module Concurrent
  module Collection
    class MriMapBackend < NonConcurrentMapBackend
      @write_lock: Thread::Mutex

      def initialize: (?untyped options) ?{ (*untyped) -> untyped } -> void | ...
      def []=: (untyped key, untyped value) -> untyped | ...
      def compute_if_absent: (untyped key) -> untyped | ...
      def compute_if_present: (untyped key) -> untyped | ...
      def compute: (untyped key) -> untyped | ...
      def merge_pair: (untyped key, untyped value) -> untyped | ...
      def replace_pair: (untyped key, untyped old_value, untyped new_value) -> (true | false) | ...
      def replace_if_exists: (untyped key, untyped new_value) -> untyped | ...
      def get_and_set: (untyped key, untyped value) -> untyped | ...
      def delete: (untyped key) -> untyped | ...
      def delete_pair: (untyped key, untyped value) -> (true | false) | ...
      def clear: () -> self | ...
    end
  end
end
