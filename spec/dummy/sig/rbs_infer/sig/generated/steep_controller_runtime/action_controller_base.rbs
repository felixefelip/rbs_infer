module ActionController
  class Base
    @__rbs_infer__performed: true?

    RBS_INFER_NO_RENDER_TARGET: nil

    def redirect_to: (*untyped) -> bool
    def render: (*untyped) -> bool
    def head: (*untyped) -> bool
    def performed?: () -> true?
    def __rbs_infer__unknown_condition?: () -> untyped
  end
end
