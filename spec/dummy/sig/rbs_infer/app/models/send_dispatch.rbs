class SendDispatch
  def call: () -> "called"

  private

  def stamp: (("post" | "a") value) -> ("stamped: post" | "stamped: a")
  def stamped?: ("stamped: post" value) -> bool
end

class SendDispatchCaller
  def stamped: () -> ("stamped: post" | "stamped: a")
  def stamped_predicate: () -> bool
  def called: () -> "called"
  def dynamic: (untyped name) -> untyped
  def underscored: () -> ("stamped: post" | "stamped: a")
  def string_named: () -> ("stamped: post" | "stamped: a")
  def stamped_publicly: () -> untyped
  def missing_name: () -> untyped
  def wrong_arity: () -> ("stamped: post" | "stamped: a")
  def splatted: (*untyped args) -> ("stamped: post" | "stamped: a")
  def guarded: () -> untyped
end
