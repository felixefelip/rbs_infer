class Example50
  module Foo
    def banana_class_method: () ?{ (*untyped) -> Symbol } -> untyped
  end

  module Baz
    extend ::Example50::Foo
  end
end

class Example50
  class Bar
    extend ::Example50::Baz::BananaMethods

    def self.call_color: () -> String
    def self.call_age: () -> Integer
  end
end

class Example50
  module Baz
    module BananaMethods
      def color: () -> String
      def age: () -> Integer
    end
  end
end
