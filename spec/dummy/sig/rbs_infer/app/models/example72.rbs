module Example72
  class Foo
    def straight: () -> "a;b"
    def first_piece: () -> "a"
    def looped: () -> "x;y"
    def conditional: (untyped flag) -> String
    def decided: (true flag) -> "a;b"
    def decides: () -> "a;b"
    def spread: (*("x" | "y") pieces) -> String
    def spreads: () -> "x;y"
    def aliased: () -> String
    def through_a_call: () -> "a"
    def fill: (Array[untyped] parts) -> Array[untyped]
    def from_a_literal: () -> "a;b"
    def with_unknown: (untyped extra) -> String
    def read_midway: () -> "a"
  end
end
