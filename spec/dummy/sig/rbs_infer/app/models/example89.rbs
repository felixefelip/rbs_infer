module Example89
  class Base
    self.@generated_methods: Module?

    def self.generated_methods: () -> Module
    def self.define_reader: ((:size | :weight) name) -> (:size | :weight)
    def self.define_reader_on_self: ((:color | :shape) name) -> (:color | :shape)
  end
end

module Example89
  class Widget < Base
  end
end

module Example89
  class Use
    def self.size: () -> 1
    def self.weight: () -> 1
    def self.color: () -> 1
  end
end
