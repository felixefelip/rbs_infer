class Example34
  module Foo
    @_bazingado_block: (^(*untyped) [self: singleton(Example34::Bar) | singleton(Example34::Baz) | Module] -> :age & ::RbsInfer::Body["def age\n        31\n      end"])?

    def include: (*singleton(::Example34::Baz) modules) -> Array[singleton(Example34::Baz)]
    def included: (?(singleton(Example34::Bar) | singleton(Example34::Baz) | Module)? base) ?{ (*untyped) [self: (singleton(Example34::Bar) | singleton(Example34::Baz) | Module)] -> :age } -> (^(*untyped) [self: (singleton(Example34::Bar) | singleton(Example34::Baz) | Module)] -> :age | nil | :age)
