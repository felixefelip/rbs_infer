module Example90
  module Core
  end

  module Core::ClassMethods
    @generated_association_methods: Module?

    def generated_association_methods: () -> singleton(Example90::Post::GeneratedAssociationMethods)
  end
end

module Example90
  class Base
    extend Core::ClassMethods

    def self.has_reader: ((:comments | :tags) name) -> (:comments | :tags)
  end
end

module Example90
  class Post < Base
  end
end

module Example90
  class Use
    def self.comments: () -> 1
    def self.tags: () -> 1
  end
end
