module Example124
  class Catalog
    @lookups: Hash[untyped, untyped]

    def initialize: () -> void
    def lookup: ("Item" entry) -> ("Catalog::Item" | :reset)
    def reset: ("Item" entry) -> :reset
  end
end

module Example124
  class Admin
    @catalog: Example124::Catalog

    def initialize: (Example124::Catalog catalog) -> void
    def clear: () -> :reset
  end
end

module Example124
  class Reader
    @catalog: Example124::Catalog

    def initialize: (Example124::Catalog catalog) -> void
    def label: () -> ("Catalog::Item" | :reset)
  end
end

module Example124
  class App
    def self.run: () -> [ "Catalog::Item", :reset ]
  end
end
