      @klass: singleton(::Comment)?
      @class_name: "Comment"?

      attr_reader name: :comments
      attr_reader scope: Proc
      attr_reader options: {  }
      attr_reader active_record: singleton(Example109::Base)
      attr_reader plural_name: String

      def initialize: (:comments name, Proc scope, {  } options, singleton(Example109::Base) active_record) -> void
      def class_name: () -> "Comment"
      def klass: () -> singleton(::Comment)
      def _klass: ("Comment" class_name) -> (singleton(::Comment) | untyped)
      def compute_class: (String name) -> untyped

      private

      def derive_class_name: () -> String
      def normalize_options: ({  } options) -> { }
    end
  end
end

