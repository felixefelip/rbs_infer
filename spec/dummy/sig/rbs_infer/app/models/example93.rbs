module Example93
  module Inflector
    self.@rule_set: Example93::Rules?

    def self.rule_set: () -> Example93::Rules
    def self.configure: () ?{ (Example93::Rules) -> Array[untyped] } -> Array[untyped]
    def self.singularize: (("posts" | "categories") word) -> String
  end
end

module Example93
  class Rules
    attr_reader singulars: Array[untyped]

    def initialize: () -> void
    def singular: (Regexp rule, ("" | "y") replacement) -> Array[untyped]
    def apply: (("posts" | "categories") word) -> String
  end
end

module Example93
  class Post
    def self.has_many_like: ((:posts | :categories) name) -> (:post_ids | :category_ids)
