class Example36
  class Foo
    self.@_bazingado_block: (^(*untyped) [self: singleton(Example36::Foo)] -> :age)?

    def self.bazinga: (*singleton(::Example36::Baz) modules) -> Array[singleton(Example36::Baz)]
    def self.bazingado: (?singleton(Example36::Foo)? base) ?{ (*untyped) [self: singleton(Example36::Foo)] -> :age } -> (^(*untyped) [self: singleton(Example36::Foo)] -> :age | nil | :age)
  end
end

class Example36
  class Baz < ::Example36::Foo
  end
end

class Example36
  class Bar < Baz
    def call_age: () -> 41
    def age: () -> 31
