class Example18
  @halted: true?

  def show: () -> "Hi, TOKEN!"
  def call: () -> "Hi, TOKEN!"?

  private

  def authenticate: () -> (Example18::User | true)
  def from_token: () -> (Example18::User | true)
  def with_token: () { (String) -> Example18::User? } -> (Example18::User | true)
  def fetch_token: () { (String) -> Example18::User? } -> Example18::User?
  def deny: () -> true
  def halt: () -> true
  def lookup: (String token) -> Example18::User?
  def token_value: () -> String
end

class Example18
  class User
    attr_reader name: "token"

    def initialize: (name: "token") -> void
  end
end

class Example18
  class Registry
    self.@user: Example18::User?

    def self.user: () -> Example18::User?
    def self.user=: (Example18::User value) -> Example18::User
  end
end
