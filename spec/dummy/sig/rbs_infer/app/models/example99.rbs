module Example99
  class Foo
    attr_reader my_hash: Hash[untyped, untyped]

    def initialize: (Hash[untyped, untyped] my_hash) -> void
    def my_hash_sum_num: () -> 35
  end
end

module Example99
  class Runner
    attr_reader foo: (Foo | Example99::Foo)?

    def run: () -> "30"
    def build_my_hash: () -> { num1: 5, num2: 10 }
    def call_num1: () -> 5
    def call_num2: () -> 10
    def change_num2: () -> 30

    class AfterRun
      attr_reader foo: Example99::Foo
    end
  end
end
