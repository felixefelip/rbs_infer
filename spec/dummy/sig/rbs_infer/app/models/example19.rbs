class Example19
  @halted: true?
  @message: "denied"?

  module Responder
    def self.deny: (Example19 host, "denied" message) -> true
  end

  def show: () -> String
  def call: () -> String?
  def halt: () -> true
  def record: ("denied"? message) -> "denied"?

  private

  def authenticate: () -> (Example19::User | bool)
  def from_token: () -> (Example19::User | bool)
  def with_token: () { (String) -> Example19::User? } -> (Example19::User | bool)
  def fetch_token: () { (String) -> Example19::User? } -> Example19::User?
  def refuse: () -> true
  def lookup: (String token) -> Example19::User?
  def token_value: () -> String
end

class Example19
  class User
    attr_reader name: "token"

    def initialize: (name: "token") -> void
  end
end

class Example19
  class Registry
    self.@user: Example19::User?

    def self.user: () -> Example19::User?
    def self.user=: (Example19::User value) -> Example19::User
  end
end
