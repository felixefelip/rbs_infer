class Example65
  class Dispatcher
    def self.dispatch: (*("ada" | { greeting: "hello" } | 1 | { step: 2 } | "/tmp/x.csv") args, **untyped) -> Object

    def handle: (*untyped) -> untyped
  end
end

class Example65
  class Rival
    def self.dispatch: (*(true | { mode: :fast }) args, **untyped) -> Object

    def handle: (*untyped) -> untyped
  end
end
