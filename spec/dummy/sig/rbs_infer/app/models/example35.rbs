class Example35
  class Foo
    self.@_bazingado_block: (^(*untyped) [self: singleton(Example35::Bar)] -> :age)?

    def self.bazinga: (singleton(::Example35::Baz) module_included) -> :age ?
    def self.bazingado: (?singleton(Example35::Bar)? base) ?{ (*untyped) [self: singleton(Example35::Bar)] -> :age } -> (:age | nil | ^(*untyped) [self: singleton(Example35::Bar)] -> :age)
  end
end

class Example35
  class Baz < ::Example35::Foo
  end
end

class Example35
  class Bar < Baz
    def call_age: () -> 41
    def age: () -> 31
  end
end
