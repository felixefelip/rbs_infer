module Example92
  module Inflector
    self.@inflections: Example92::Rules?

    def self.inflections: () -> Example92::Rules
    def self.singularize: (("posts" | "categories") word) -> ("post" | "category")
  end
end

module Example92
  class Rules
    attr_reader singulars: Array[untyped]

    def initialize: () -> void
    def singular: (Regexp rule, ("" | "y") replacement) -> ([ [ Regexp, "" ] ] | [ [ Regexp, "y" ], [ Regexp, "" ] ])
    def apply: (("posts" | "categories") word) -> ("post" | "category")
  end
end

module Example92
  class Post
    def self.has_many_like: ((:posts | :categories) name) -> (:post_ids | :category_ids)
    def self.summary: () -> Array[Array[untyped]]
  end
end
