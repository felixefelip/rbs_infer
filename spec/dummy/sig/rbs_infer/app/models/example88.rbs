module Example88
  module Inflector
    self.@rules: Example88::Rules?

    def self.rules: () -> Example88::Rules
    def self.singularize: (String word) -> String
  end
end

module Example88
  class Rules
    attr_reader singulars: Array[untyped]

    def initialize: () -> Array[untyped]
    def singular: (Regexp rule, ("" | "y") replacement) -> Array[untyped]
  end
end

module Example88
  class Base
    def self.has_many_like: ((:comments | :categories) name) -> untyped
  end
end

