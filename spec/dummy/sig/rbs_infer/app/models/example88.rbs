module Example88
  module Inflector
    self.@rules: Example88::Rules?

    def self.rules: () -> Example88::Rules
    def self.singularize: (("comments" | "categories") word) -> String
  end
end

module Example88
  class Rules
    attr_reader singulars: Array[untyped]

    def initialize: () -> void
    def singular: (Regexp rule, ("" | "y") replacement) -> ([ [ Regexp, "" ] ] | [ [ Regexp, "y" ], [ Regexp, "" ] ])
  end
end

module Example88
  class Base
    def self.has_many_like: ((:comments | :categories) name) -> (:comment_ids | :category_ids)
  end
end

module Example88
  class Post < Base
    def self.summary: () -> Array[untyped]
  end
end
